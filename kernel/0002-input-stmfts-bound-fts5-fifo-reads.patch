+}
+
+static int stmfts5_read_events(struct stmfts_data *sdata)
+{
+	int err, remaining;
+
+	/* A full FIFO read can replay stale FTS5 contacts after the queue ends. */
+	err = stmfts_read_event_bytes(sdata, sdata->data, STMFTS_EVENT_SIZE);
+	if (err)
+		return err;
+	if (sdata->data[0] == STMFTS_EV_NO_EVENT)
+		return 0;
+
+	remaining = sdata->data[STMFTS_EVENT_SIZE - 1] & STMFTS5_MASK_EVENTS_LEFT;
+	if (!remaining)
+		return 1;
+
+	err = stmfts_read_event_bytes(sdata, sdata->data + STMFTS_EVENT_SIZE,
+				      remaining * STMFTS_EVENT_SIZE);
+	if (err) {
+		dev_err_ratelimited(&sdata->client->dev,
+				    "failed to read remaining events: %d\n", err);
+		return 1;
+	}
+	return 1 + remaining;
+}
